# ── Server ─────────────────────────────────────────────────
PORT=3005
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3006,*
PORTAL_URL=http://localhost:3006

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=careerlm_api

# ── CareerCamp AI Gateway (internal proxy target) ──────────
CAREERCAMP_URL=http://localhost:3002
CS_TRANSFORMER_API_KEY=your-cs-transformer-api-key

# ── Email (Nodemailer) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=api@careerstudiomax.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=CareerStudioMax Developer Cloud <api@careerstudiomax.com>

# ── Stripe billing (paid developer tiers — free tier works without) ─
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_PRICE_PRO=price_pro_monthly_id
STRIPE_PRICE_PLUS=price_plus_monthly_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly_id

# ── Production values (for reference — not this file's defaults) ────
# PORTAL_URL=https://dev.careerstudiomax.com
# CAREERCAMP_URL=https://careercamp-ai.onrender.com
# This service's own production base URL is https://careerlm-api.careerstudiomax.com
# — NOT api.careerstudiomax.com, which already belongs to CSTM-2 (cs_fixed).
