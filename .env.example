# ── CareerCamp AI Gateway (internal) ─────────────────────────
CAREERCAMP_URL=http://localhost:3002
CAREERCAMP_INTERNAL_KEY=your-cs-transformer-api-key

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=careerlm_api

# ── Stripe billing ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PRICE_STARTER=price_starter_monthly_id
STRIPE_PRICE_PROFESSIONAL=price_professional_monthly_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly_id

# ── Email (Nodemailer) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=api@careerstudiomax.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=CareerLM API <api@careerstudiomax.com>

# ── Platform ──────────────────────────────────────────────────
PORT=3005
PLATFORM_URL=https://api.careerstudiomax.com
NODE_ENV=development
